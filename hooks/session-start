#!/usr/bin/env bash
# SessionStart: inject a short, factual project brief (git state + skill index). Never long.
set -u
root="${CLAUDE_PROJECT_DIR:-$PWD}"
brief=""
if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  b=$(git -C "$root" branch --show-current 2>/dev/null); n=$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  last=$(git -C "$root" log -1 --format='%h %s' 2>/dev/null)
  brief="git: branch=$b, uncommitted=$n, last=\"$last\". "
fi
brief="${brief}Skillkeel Starter active: guard-bash (blocks destructive shell), secret-scan (blocks credentials in writes). Skills: commit-message, pr-description, claude-md-init, changelog, readme-refresh, dependency-audit, secret-audit, test-gap-finder. Use the Skill tool by name."
esc=$(printf '%s' "$brief" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":%s}}\n' "$esc"
