#!/usr/bin/env bash
# PreToolUse(Write|Edit|MultiEdit) guard: blocks writing obvious credentials into files.
# Exit 2 + stderr = block. Skips *.md, *.example, *.sample and anything under .secrets/.
# Override for a session: SKILLKEEL_ALLOW_SECRETS=1
if ! command -v python3 >/dev/null 2>&1; then
  [ -n "${SKILLKEEL_ALLOW_SECRETS:-}" ] && exit 0
  echo "skillkeel secret-scan: blocked (python3 is needed to check this write). If intended, ask the user; they can set SKILLKEEL_ALLOW_SECRETS=1 for this session." >&2; exit 2
fi
exec python3 "$(dirname "$0")/secret-scan.py"
